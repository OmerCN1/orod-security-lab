OROD_ENV=development
OROD_API_HOST=127.0.0.1
OROD_API_PORT=8000
OROD_FRONTEND_ORIGIN=http://localhost:5173
OROD_DATABASE_PATH=../data/orod.sqlite3
OROD_CHECKPOINT_PATH=../data/checkpoints.sqlite3
OROD_CHROMA_PATH=../data/chroma
OROD_WORKSPACE_ROOT=../workspaces
OROD_OLLAMA_BASE_URL=http://localhost:11434
OROD_CHAT_MODEL=qwen2.5-coder:14b
OROD_EMBEDDING_MODEL=nomic-embed-text
# Set only when evaluating or running a claude-* chat model.
OROD_ANTHROPIC_API_KEY=
OROD_LLM_MAX_OUTPUT_TOKENS=16000
OROD_LLM_TIMEOUT_SECONDS=180
OROD_USE_LLM=true
# Pause before publishing and wait for an approve/reject/regenerate decision.
OROD_REQUIRE_HUMAN_APPROVAL=true
OROD_ENABLE_GITHUB_PUBLISH=false
OROD_MAX_FILE_BYTES=1000000
OROD_MAX_DIFF_LINES=800
OROD_COMMAND_TIMEOUT_SECONDS=120
# Runs beyond this limit wait in `queued`; a resumed review also takes a slot.
OROD_MAX_CONCURRENT_RUNS=2
# How long a cancel waits for a run's subprocesses and containers to be cleaned up.
OROD_CANCEL_GRACE_SECONDS=15
# Build with `make validation-image`; GitHub validation never falls back to host execution.
OROD_VALIDATION_IMAGE=orod-validation:local
